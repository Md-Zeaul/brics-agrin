# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
#     cp .env.example .env
#     source .env
#
# No secret values belong in this file or in `.env` — only a project id, a
# browser-restricted Maps key, and the *path* to a key that lives elsewhere.

# The Google Cloud project. Both of us use the same one.
export GCP_PROJECT=your-project-id

# Google Maps Platform browser key, for the satellite basemap on S1.
# Without it the map falls back to a schematic renderer and everything else
# still works, so this is optional on day one.
# Restrict it to HTTP referrers before using it anywhere but localhost.
export MAPS_KEY=

# Vertex AI region for M1's advisory model. Kept configurable because a demo
# whose selling point is that farm data stays in-country should not quietly
# route its advisory through Iowa.
export VERTEX_REGION=asia-south1

# Set to 1 to skip the model entirely and run M1 on rules alone. The card works
# either way; this just makes the choice explicit rather than accidental.
# export M1_DISABLE_GEMINI=1

# --- Earth Engine credentials: pick ONE path ---------------------------------
#
# Path A — Application Default Credentials. Use this one.
#   Nothing to set here. Run, once, with the Google account that holds a role
#   on the project:
#
#       gcloud auth application-default login
#       gcloud auth application-default set-quota-project "$GCP_PROJECT"
#
#   Leave GCP_SA_JSON unset and M0 picks the credential up from the file gcloud
#   writes. Confirm with: .venv/bin/python backend/check_ee.py
#
# Path B — a service-account key file. This is what the deployed Cloud Function
#   uses. Only set it if you have your own key; never share one between people,
#   because a shared key makes the audit log unable to tell you apart and makes
#   revocation an all-or-nothing act.
#
#       export GCP_SA_JSON=$HOME/.config/agrisetu/gcp-sa.json
#
#   Keep the file outside the repo, chmod 600.

# --- IAM roles the credential needs -------------------------------------------
#
#   roles/earthengine.writer   or Earth Engine access on the project  (M0 NDVI)
#   roles/aiplatform.user                                             (M1 model)
#
# Enabling the Agent Platform API is not enough on its own: the API being on and
# the caller being allowed to call it are two separate switches, and missing the
# second surfaces as a 403 on predict, not as a disabled API.
